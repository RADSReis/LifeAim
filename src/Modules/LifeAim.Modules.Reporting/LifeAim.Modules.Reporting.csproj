<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the DLL, so the scripts always ship with the code that expects them. -->
    <EmbeddedResource Include="Infrastructure\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LifeAim.Modules.Reporting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\LifeAim.BuildingBlocks\LifeAim.BuildingBlocks.csproj" />
    <!-- Only the public contracts: the summaries count goals, routines, progress and check-ins, never their tables. -->
    <ProjectReference Include="..\LifeAim.Modules.Goals\LifeAim.Modules.Goals.csproj" />
    <ProjectReference Include="..\LifeAim.Modules.Progress\LifeAim.Modules.Progress.csproj" />
  </ItemGroup>

</Project>

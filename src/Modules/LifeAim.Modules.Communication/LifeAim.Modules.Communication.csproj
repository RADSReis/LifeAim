<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the DLL, so the scripts always ship with the code that expects them. -->
    <EmbeddedResource Include="Infrastructure\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\LifeAim.BuildingBlocks\LifeAim.BuildingBlocks.csproj" />
    <!-- Only for Agents' public contract (IPippin): a DM is handed to Pippin. -->
    <ProjectReference Include="..\LifeAim.Modules.Agents\LifeAim.Modules.Agents.csproj" />
  </ItemGroup>

</Project>
